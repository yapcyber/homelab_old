# =============================================================================
# scripts/opnsense-api.env.example — modèle (VALEURS FACTICES)
# =============================================================================
# Sert à produire scripts/opnsense-api.enc.env, chiffré par SOPS :
#
#   cp scripts/opnsense-api.env.example /tmp/opn.env   # puis remplir
#   sops --encrypt /tmp/opn.env > scripts/opnsense-api.enc.env
#   shred -u /tmp/opn.env
#
# Ne JAMAIS committer la version en clair. Voir :
#   docs/runbooks/sauvegarde-opnsense-drive.md
# =============================================================================

# Interface d'administration du pare-feu (VLAN 100)
OPNSENSE_URL=https://10.0.100.1

# Clé/secret d'une API key OPNsense dédiée à la sauvegarde.
# Le compte porteur ne doit avoir QUE le privilège
# « Diagnostics: Configuration History » (accès /api/core/backup/*).
OPNSENSE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPNSENSE_API_SECRET=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Épinglage de la clé publique TLS du pare-feu (certificat auto-signé).
# Optionnel mais recommandé : sans lui, la connexion n'est pas authentifiée.
# Obtention :
#   openssl s_client -connect 10.0.100.1:443 </dev/null 2>/dev/null \
#     | openssl x509 -pubkey -noout \
#     | openssl pkey -pubin -outform der \
#     | openssl dgst -sha256 -binary | base64
OPNSENSE_PINNED_PUBKEY=sha256//zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz=
